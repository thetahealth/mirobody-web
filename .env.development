# Loaded by `npm run dev`. Local overrides go in .env.local (gitignored).

# Names this build in the Sentry environment, the app-version meta tags and the
# startup console line. Substrings are meaningful: "prod" turns on production
# Sentry sample rates, "test" enables the eruda mobile console, "cn" defaults
# the UI language to 简体中文 when the browser gives no usable hint.
VITE_ENV=development

# Empty = call the API with relative paths, which the dev server proxies to
# VITE_DEV_PROXY_TARGET (see vite.config.js) — same-origin, so no CORS setup.
VITE_BASE_URL_MCP=
