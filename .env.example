# Every variable this app reads. Copy the ones you need into .env.local
# (gitignored, applies to every mode) or .env.<mode>.local.
#
# Committed defaults live in .env.development and .env.production — nothing
# here is required for a normal self-hosted build.

# ── API ───────────────────────────────────────────────────────────────────────
# Where the browser sends API calls. Empty means same-origin, which is what a
# mirobody backend serving this bundle wants. An absolute URL is for hosting
# the bundle away from the backend (which then needs CORS for your origin).
VITE_BASE_URL_MCP=

# Dev only: where the Vite proxy forwards /api, /auth, /files, /ws … .
# 18060 is the port `./deploy.sh` publishes in the mirobody repo.
VITE_DEV_PROXY_TARGET=http://localhost:18060

# Dev only: extra Host headers the dev server should accept, comma-separated.
# localhost is always allowed.
VITE_DEV_ALLOWED_HOSTS=

# ── Build identity ───────────────────────────────────────────────────────────
# Free-form label for this build. Substrings matter: "prod" → production Sentry
# sample rates, "test" → eruda mobile console, "cn" → 简体中文 as the language
# fallback. Always set it; the app reads it at startup.
VITE_ENV=production

# ── Error reporting (optional) ───────────────────────────────────────────────
# Unset = Sentry is not initialised at all, and no error data leaves the
# browser. Set a DSN to opt in.
VITE_SENTRY_DSN=

# Source-map upload at build time (optional, and independent of the DSN).
# SENTRY_AUTH_TOKEN is what switches the upload plugin on.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Companion developer app (optional) ───────────────────────────────────────
# Some deployments run a separate developer / API-platform app. Set its base URL
# to show the Settings "Developer Platform" card and enable the /developer
# route; unset, those entry points do not exist.
VITE_CDM_URL=

# Cross-subdomain single sign-on with that app: the shared parent domain the
# session cookie is scoped to (leading dot optional). Unset — the default —
# means the session stays in this origin's localStorage and no cookie is
# written. Only set it when a sibling app on the same registrable domain has to
# read the same session.
VITE_SHARED_SESSION_DOMAIN=
