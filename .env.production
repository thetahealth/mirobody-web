# Loaded by `npm run build`. Local overrides go in .env.production.local
# (gitignored).

VITE_ENV=production

# Empty = same-origin. The mirobody backend serves this bundle itself, so the
# API is always on the origin the page was loaded from. Set an absolute URL
# only when you host the bundle separately from the backend — and then the
# backend needs CORS for that origin.
VITE_BASE_URL_MCP=
